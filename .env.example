# Server
PORT=4000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@host:port/database

# Auth
JWT_SECRET=your_jwt_secret_key
ACCESS_TOKEN_SECRET=your_access_token_secret_key
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cookies
# Local HTTP development: COOKIE_SECURE=false, COOKIE_SAME_SITE=lax
# HTTPS cross-site deployment: COOKIE_SECURE=true, COOKIE_SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Email (SMTP - dùng cho chức năng đặt lại mật khẩu)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Cloudinary (upload ảnh đại diện)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
